<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.conductor-companion.phone</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__HOME__/.claude/agent-status/phone/server.py</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>3</integer>
  <key>StandardErrorPath</key><string>__HOME__/.claude/agent-status/phone/server.log</string>
  <key>StandardOutPath</key><string>__HOME__/.claude/agent-status/phone/server.log</string>
</dict>
</plist>
